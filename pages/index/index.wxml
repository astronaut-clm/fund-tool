<view class="page" bindtap="onPageTap" bindtouchstart="onTabTouchStart" bindtouchmove="onTabTouchMove" bindtouchend="onTabTouchEnd" bindtouchcancel="onTabTouchCancel">
  <!-- 搜索（catchtap 阻止冒泡） -->
  <view class="search-bar" catchtap="onSearchBarTap">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜索基金代码"
      placeholder-class="ph"
      confirm-type="search"
      bindinput="onInput"
    />
    <text wx:if="{{keyword}}" class="clear-btn" catchtap="onClearSearch">✕</text>
  </view>

  <!-- 搜索历史（catchtap 阻止冒泡） -->
  <view wx:if="{{showResults && history.length}}" class="history" catchtap="noop">
    <view class="history-head">
      <text class="history-title">搜索历史</text>
      <text class="history-clear" catchtap="onClearHistory">清空</text>
    </view>
    <view class="history-tags">
      <view
        wx:for="{{history}}"
        wx:key="code"
        class="history-tag"
        catchtap="onPickHistory"
        data-code="{{item.code}}"
      >{{item.name}}</view>
    </view>
  </view>

  <!-- 搜索结果（catchtap 阻止冒泡） -->
  <view wx:if="{{showResults && keyword}}" class="results card" catchtap="noop">
    <view wx:if="{{searching}}" class="result-tip">搜索中…</view>
    <view wx:elif="{{!results.length}}" class="result-tip">未找到相关基金</view>
    <view
      wx:for="{{results}}"
      wx:key="code"
      class="result-item"
    >
      <view
        class="result-main"
        catchtap="onPickFund"
        data-code="{{item.code}}"
        data-name="{{item.name}}"
      >
        <text class="result-name">{{item.name}}</text>
        <text class="result-sub">{{item.code}}<text wx:if="{{item.type}}"> · {{item.type}}</text></text>
      </view>
      <text
        class="result-add {{item.added ? 'added' : ''}}"
        catchtap="onTogglePick"
        data-code="{{item.code}}"
        data-name="{{item.name}}"
        data-index="{{index}}"
      >{{item.added ? '已添加' : '+ 添加'}}</text>
    </view>
  </view>

  <view wx:if="{{!showResults}}" class="asset card" style="font-size: {{assetValueFontSize}}rpx;" catchtap="noop">
    <view class="asset-item">
      <view class="asset-label">总资产(元)</view>
      <view class="asset-value">{{assetText}}</view>
    </view>
    <view class="asset-item">
      <view class="asset-label">持有收益</view>
      <view class="asset-value {{totalProfitCls}}">{{totalProfitText}}</view>
    </view>
    <view class="asset-item right">
      <view class="asset-label">{{profitLabel}}</view>
      <view class="asset-value {{profitCls}}">{{profitText}}</view>
    </view>
  </view>

  <!-- 持有 / 自选 + 操作 -->
  <view wx:if="{{!showResults}}" class="tabs" catchtap="noop">
    <view class="tabs-left">
      <text class="tab {{tab === 'hold' ? 'on' : ''}}" catchtap="switchTab" data-tab="hold">持有</text>
      <text class="tab {{tab === 'watch' ? 'on' : ''}}" catchtap="switchTab" data-tab="watch">自选</text>
    </view>
    <view class="tabs-right">
      <text wx:if="{{holdingsEdit}}" class="action-link" catchtap="cancelHoldingsEdit">取消</text>
      <text wx:if="{{holdingsEdit}}" class="action-link" catchtap="saveHoldingsEdit">保存</text>
      <text wx:if="{{editMode}}" class="action-link delete {{selectedCount ? 'active' : ''}}" catchtap="onDeleteSelected">删除{{selectedCount ? '(' + selectedCount + ')' : ''}}</text>
      <view wx:if="{{tab === 'hold' && !editMode && !holdingsEdit}}" class="gear-wrap">
        <text class="gear {{backupBusy ? 'blinking' : ''}}" catchtap="onGearTap">⚙</text>
        <view wx:if="{{menuShow}}" class="gear-menu card">
          <view class="menu-item" catchtap="onMenuSync">
            <text class="menu-icon cloud">☁</text>
            <text class="menu-title">云同步</text>
          </view>
          <view class="menu-item" catchtap="onMenuEditHoldings">
            <view class="menu-icon setting">
              <view class="bars">
                <view class="bar"></view>
                <view class="bar"></view>
                <view class="bar"></view>
              </view>
            </view>
            <text class="menu-title">修改持仓</text>
          </view>
        </view>
      </view>
      <text wx:elif="{{editMode}}" class="gear exit" catchtap="onToggleEdit">退出</text>
    </view>
  </view>

  <!-- 菜单遮罩：点击外部关闭 -->
  <view wx:if="{{menuShow}}" class="menu-mask" catchtap="closeMenu"></view>

  <!-- 自选列表 -->
  <view wx:if="{{funds.length && !showResults && tab === 'watch'}}" class="list">
    <view class="fund-list">
      <view wx:if="{{!editMode}}" class="tr th">
        <text class="td name">名称</text>
        <text class="td num">涨幅<text wx:if="{{pctDateText}}" class="sub">{{pctDateText}}</text></text>
      </view>
      <view
        wx:for="{{funds}}"
        wx:key="code"
        class="fund {{item.cls}} {{dragIndex === index ? 'dragging' : ''}} {{editMode && item.selected ? 'selected' : ''}}"
        style="{{dragIndex === index ? ('transform: translateY(' + dragOffsetY + 'px);') : (item.shift ? ('transform: translateY(' + item.shift + 'px);') : '')}}"
        catchtap="onFundTap"
        bindlongpress="onFundLongPress"
        data-code="{{item.code}}"
        data-index="{{index}}"
      >
        <view wx:if="{{editMode}}" class="check-box {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</view>
        <view class="fund-name">{{item.name}}</view>
        <view wx:if="{{!editMode}}" class="fund-pct {{item.cls}}">{{item.pctText}}</view>
        <view
          wx:if="{{editMode}}"
          class="drag-handle"
          catchtouchstart="onDragTouchStart"
          catchtouchmove="onDragTouchMove"
          catchtouchend="onDragTouchEnd"
          data-index="{{index}}"
        >≡</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!showResults && tab === 'hold' && holdingsEdit}}" class="list" catchtap="noop">
    <view class="fund-list">
      <view class="tr th">
        <text class="td name">名称</text>
        <text class="td num profit-col">持有收益</text>
        <text class="td num pct-col">持有金额</text>
      </view>
      <view wx:if="{{holdingsError}}" class="holdings-editor-error">{{holdingsError}}</view>
      <view wx:for="{{holdingsDraft}}" wx:key="code" class="fund holdings-editor-row">
        <view class="fund-name">{{item.name}}</view>
        <input class="fund-pct profit-col holdings-editor-input" type="text" value="{{item.profit}}" data-index="{{index}}" data-field="profit" bindinput="onHoldingDraftInput" />
        <input class="fund-pct pct-col holdings-editor-input" type="digit" value="{{item.amount}}" data-index="{{index}}" data-field="amount" bindinput="onHoldingDraftInput" />
        <text wx:if="{{item.error}}" class="holdings-editor-error">{{item.error}}</text>
      </view>
      <view class="fund holdings-editor-row">
        <view class="fund-name holdings-add-name">
          <input class="holdings-add-input" type="number" maxlength="6" value="{{holdingAddCode}}" placeholder="基金代码" bindinput="onHoldingAddInput" />
          <text wx:if="{{holdingAddSearching || holdingAddError}}" class="holdings-add-status {{holdingAddSearching ? 'searching' : ''}}">{{holdingAddSearching ? '查询中…' : holdingAddError}}</text>
        </view>
        <text class="fund-pct profit-col holdings-add-default">0.00</text>
        <text class="fund-pct pct-col holdings-add-default">0.00</text>
      </view>
    </view>
  </view>

  <!-- 持有列表 -->
  <view wx:if="{{!holdingsEdit && !showResults && tab === 'hold' && holdRows.length}}" class="list" catchtap="noop">
    <view class="fund-list">
      <view wx:if="{{!editMode}}" class="tr th">
        <text class="td name">名称</text>
        <text class="td num profit-col">收益<text wx:if="{{pctDateText}}" class="sub">{{pctDateText}}</text></text>
        <text class="td num pct-col">涨幅<text wx:if="{{pctDateText}}" class="sub">{{pctDateText}}</text></text>
      </view>
      <view
        wx:for="{{holdRows}}"
        wx:key="code"
        class="fund {{item.cls}} {{dragIndex === index ? 'dragging' : ''}} {{editMode && item.selected ? 'selected' : ''}}"
        style="{{dragIndex === index ? ('transform: translateY(' + dragOffsetY + 'px);') : (item.shift ? ('transform: translateY(' + item.shift + 'px);') : '')}}"
        catchtap="onHoldRowTap"
        bindlongpress="onHoldRowLongPress"
        data-code="{{item.code}}"
        data-index="{{index}}"
      >
        <view wx:if="{{editMode}}" class="check-box {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</view>
        <view class="fund-name">{{item.name}}</view>
        <view wx:if="{{!editMode}}" class="fund-pct profit-col {{item.profitCls}}">{{item.profitText}}</view>
        <view wx:if="{{!editMode}}" class="fund-pct pct-col {{item.cls}}">{{item.pctText}}</view>
        <view
          wx:if="{{editMode}}"
          class="drag-handle"
          catchtouchstart="onDragTouchStart"
          catchtouchmove="onDragTouchMove"
          catchtouchend="onDragTouchEnd"
          data-index="{{index}}"
        >≡</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!holdingsEdit && !showResults && ((tab === 'hold' && !holdRows.length) || (tab === 'watch' && !funds.length))}}" class="empty">
    <view class="empty-art">
      <text class="art-line">帮助您记录</text>
      <text class="art-main">每一天</text>
      <text class="art-line">的基金变动</text>
    </view>
  </view>

  <!-- 底部风险提示（常驻显示） -->
  <view class="disclaimer" catchtap="noop">数据仅供参考，不构成任何投资建议！</view>
</view>
