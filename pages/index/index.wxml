<view class="page" bindtap="onPageTap">
  <!-- 搜索（catchtap 阻止冒泡，避免点搜索框时收起） -->
  <view class="search-bar" catchtap="onSearchBarTap">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜索基金代码 / 名称"
      placeholder-class="ph"
      confirm-type="search"
      bindinput="onInput"
    />
    <text wx:if="{{keyword}}" class="clear-btn" catchtap="onClearSearch">✕</text>
  </view>

  <!-- 搜索历史（搜索时显示，阻止冒泡避免点击历史区域时收起） -->
  <view wx:if="{{showResults && history.length}}" class="history" catchtap="noop">
    <view class="history-head">
      <text class="history-title">搜索历史</text>
      <text class="history-clear" catchtap="onClearHistory">清空</text>
    </view>
    <view class="history-tags">
      <view
        wx:for="{{history}}"
        wx:key="code"
        class="history-tag"
        catchtap="onPickHistory"
        data-code="{{item.code}}"
      >{{item.name}}</view>
    </view>
  </view>

  <!-- 搜索结果（阻止冒泡，点击结果项不收起） -->
  <view wx:if="{{showResults && keyword}}" class="results card" catchtap="noop">
    <view wx:if="{{searching}}" class="result-tip">搜索中…</view>
    <view wx:elif="{{!results.length}}" class="result-tip">未找到相关基金</view>
    <view
      wx:for="{{results}}"
      wx:key="code"
      class="result-item"
    >
      <view
        class="result-main"
        catchtap="onPickFund"
        data-code="{{item.code}}"
        data-name="{{item.name}}"
      >
        <text class="result-name">{{item.name}}</text>
        <text class="result-sub">{{item.code}}<text wx:if="{{item.type}}"> · {{item.type}}</text></text>
      </view>
      <text
        class="result-add {{item.added ? 'added' : ''}}"
        catchtap="onTogglePick"
        data-code="{{item.code}}"
        data-name="{{item.name}}"
        data-index="{{index}}"
      >{{item.added ? '已添加' : '+ 添加'}}</text>
    </view>
  </view>

  <!-- 资产卡（搜索框下，tab 之上） -->
  <view wx:if="{{!showResults}}" class="asset card" catchtap="noop">
    <view class="asset-item">
      <view class="asset-label">总资产(元)</view>
      <view class="asset-value">{{assetText}}</view>
    </view>
    <view class="asset-item">
      <view class="asset-label">持有收益</view>
      <view class="asset-value {{totalProfitCls}}">{{totalProfitText}}</view>
    </view>
    <view class="asset-item right">
      <view class="asset-label">当日收益</view>
      <view class="asset-value {{profitCls}}">{{profitText}}</view>
    </view>
  </view>

  <!-- 持有 / 自选 + 操作 -->
  <view wx:if="{{!showResults}}" class="tabs" catchtap="noop">
    <view class="tabs-left">
      <text class="tab {{tab === 'hold' ? 'on' : ''}}" catchtap="switchTab" data-tab="hold">持有</text>
      <text class="tab {{tab === 'watch' ? 'on' : ''}}" catchtap="switchTab" data-tab="watch">自选</text>
      <text class="backup-tab {{backupBusy ? 'blinking' : ''}}" catchtap="onOpenBackup">☁</text>
    </view>
    <view class="tabs-right">
      <text wx:if="{{tab === 'hold'}}" class="icon-add" catchtap="onAddHolding">＋</text>
      <text wx:if="{{tab === 'watch' && editMode && funds.length}}" class="action-link select-all" catchtap="onSelectAll">{{allSelected ? '取消全选' : '全选'}}</text>
      <text wx:if="{{tab === 'watch' && editMode && funds.length}}" class="action-link delete {{selectedCount ? 'active' : ''}}" catchtap="onDeleteSelected">删除{{selectedCount ? '(' + selectedCount + ')' : ''}}</text>
      <text wx:if="{{tab === 'watch' && funds.length}}" class="gear" catchtap="onToggleEdit">{{editMode ? '退出' : '⚙'}}</text>
    </view>
  </view>

  <!-- 添加持仓弹窗 -->
  <view wx:if="{{addModalShow}}" class="modal-mask" catchtap="closeAddModal">
    <view class="modal card" catchtap="noop">
      <view class="modal-title">{{editModeOn ? '修改持仓' : '添加持仓'}}</view>
      <view class="form-item">
        <text class="form-label">基金代码</text>
        <input
          class="form-input {{editModeOn ? 'readonly' : ''}}"
          value="{{addCode}}"
          placeholder=""
          placeholder-class="ph"
          maxlength="{{maxCodeLen}}"
          type="number"
          disabled="{{editModeOn}}"
          bindinput="onAddCodeInput"
        />
        <text wx:if="{{addSearching}}" class="form-name">查询中…</text>
        <text wx:elif="{{addFundName}}" class="form-name">{{addFundName}}</text>
        <text wx:elif="{{addError}}" class="form-name error">{{addError}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">持有金额(元)</text>
        <input
          class="form-input"
          value="{{addAmount}}"
          placeholder="0.00"
          placeholder-class="ph"
          type="digit"
          bindinput="onAddAmountInput"
        />
      </view>
      <view class="form-item">
        <text class="form-label">持有收益(元)</text>
        <input
          class="form-input"
          value="{{addProfit}}"
          placeholder="0.00（可负）"
          placeholder-class="ph"
          type="text"
          bindinput="onAddProfitInput"
        />
      </view>
      <view class="modal-actions">
        <text class="btn-cancel" catchtap="closeAddModal">取消</text>
        <text class="btn-save" catchtap="onAddSave">保存</text>
      </view>
    </view>
  </view>

  <!-- 自选列表 -->
  <view wx:if="{{funds.length && !showResults && tab === 'watch'}}" class="list">
    <view class="fund-list">
      <view wx:if="{{!editMode}}" class="tr th">
        <text class="td name">名称</text>
        <text class="td num">涨幅<text wx:if="{{pctDateText}}" class="sub">{{pctDateText}}</text></text>
      </view>
      <view
        wx:for="{{funds}}"
        wx:key="code"
        class="fund {{item.cls}} {{dragIndex === index ? 'dragging' : ''}} {{editMode && item.selected ? 'selected' : ''}}"
        style="{{dragIndex === index ? ('transform: translateY(' + dragOffsetY + 'px);') : (item.shift ? ('transform: translateY(' + item.shift + 'px);') : '')}}"
        catchtap="onFundTap"
        data-code="{{item.code}}"
        data-index="{{index}}"
      >
        <view wx:if="{{editMode}}" class="check-box {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</view>
        <view class="fund-name">{{item.name}}</view>
        <view wx:if="{{!editMode}}" class="fund-pct {{item.cls}}">{{item.pctText}}</view>
        <view
          wx:if="{{editMode}}"
          class="drag-handle"
          catchtouchstart="onDragTouchStart"
          catchtouchmove="onDragTouchMove"
          catchtouchend="onDragTouchEnd"
          data-index="{{index}}"
          data-code="{{item.code}}"
        >≡</view>
      </view>
    </view>

    <view wx:if="{{editMode}}" class="edit-hint">勾选基金后可批量删除，拖拽 ≡ 手柄可排序</view>
  </view>

  <!-- 持有列表 -->
  <view wx:if="{{!showResults && tab === 'hold' && holdRows.length}}" class="list" catchtap="noop">
    <view class="fund-list">
      <view class="tr th">
        <text class="td name">名称</text>
        <text class="td num profit-col">收益<text wx:if="{{pctDateText}}" class="sub">{{pctDateText}}</text></text>
        <text class="td num">涨幅<text wx:if="{{pctDateText}}" class="sub">{{pctDateText}}</text></text>
      </view>
      <view
        wx:for="{{holdRows}}"
        wx:key="code"
        class="fund {{item.cls}}"
        catchtap="goDetail"
        bindlongpress="onHoldRowLongPress"
        data-code="{{item.code}}"
      >
        <view class="fund-name">{{item.name}}</view>
        <view class="fund-pct profit-col {{item.profitCls}}">{{item.profitText}}</view>
        <view class="fund-pct {{item.cls}}">{{item.pctText}}</view>
      </view>
    </view>
  </view>

  <!-- 空状态：持有无持仓 或 自选无基金 -->
  <view wx:if="{{!showResults && ((tab === 'hold' && !holdRows.length) || (tab === 'watch' && !funds.length))}}" class="empty">
    <view class="empty-art">
      <text class="art-line">帮助您记录</text>
      <text class="art-main">每一天</text>
      <text class="art-line">的基金变动</text>
    </view>
  </view>
</view>
