<view class="page" bindtap="onPageTap">
  <!-- 搜索（catchtap 阻止冒泡，避免点搜索框时收起） -->
  <view class="search-bar" catchtap="onSearchBarTap">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜索基金代码 / 名称"
      placeholder-class="ph"
      confirm-type="search"
      bindinput="onInput"
    />
    <text wx:if="{{keyword}}" class="clear-btn" catchtap="onClearSearch">✕</text>
  </view>

  <!-- 搜索历史（搜索时显示，阻止冒泡避免点击历史区域时收起） -->
  <view wx:if="{{showResults && history.length}}" class="history" catchtap="noop">
    <view class="history-head">
      <text class="history-title">搜索历史</text>
      <text class="history-clear" catchtap="onClearHistory">清空</text>
    </view>
    <view class="history-tags">
      <view
        wx:for="{{history}}"
        wx:key="code"
        class="history-tag"
        catchtap="onPickHistory"
        data-code="{{item.code}}"
      >{{item.name}}</view>
    </view>
  </view>

  <!-- 搜索结果（阻止冒泡，点击结果项不收起） -->
  <view wx:if="{{showResults && keyword}}" class="results card" catchtap="noop">
    <view wx:if="{{searching}}" class="result-tip">搜索中…</view>
    <view wx:elif="{{!results.length}}" class="result-tip">未找到相关基金</view>
    <view
      wx:for="{{results}}"
      wx:key="code"
      class="result-item"
    >
      <view
        class="result-main"
        catchtap="onPickFund"
        data-code="{{item.code}}"
        data-name="{{item.name}}"
      >
        <text class="result-name">{{item.name}}</text>
        <text class="result-sub">{{item.code}}<text wx:if="{{item.type}}"> · {{item.type}}</text></text>
      </view>
      <text
        class="result-add {{item.added ? 'added' : ''}}"
        catchtap="onTogglePick"
        data-code="{{item.code}}"
        data-name="{{item.name}}"
        data-index="{{index}}"
      >{{item.added ? '已添加' : '+ 添加'}}</text>
    </view>
  </view>

  <!-- 自选列表 -->
  <view wx:if="{{funds.length && !showResults}}" class="list">
    <view class="section-head">
      <text class="section-title">{{editMode ? '管理自选' : '我的自选'}}</text>
      <view class="section-actions">
        <text wx:if="{{editMode}}" class="action-link select-all" catchtap="onSelectAll">{{allSelected ? '取消全选' : '全选'}}</text>
        <text wx:if="{{editMode}}" class="action-link delete {{selectedCount ? 'active' : ''}}" catchtap="onDeleteSelected">删除{{selectedCount ? '(' + selectedCount + ')' : ''}}</text>
        <text class="gear" catchtap="onToggleEdit">{{editMode ? '退出' : '⚙'}}</text>
      </view>
    </view>

    <view class="fund-list">
      <view
        wx:for="{{funds}}"
        wx:key="code"
        class="fund {{item.cls}} {{dragIndex === index ? 'dragging' : ''}} {{dragOverIndex === index ? 'drag-over' : ''}} {{editMode && item.selected ? 'selected' : ''}}"
        catchtap="onFundTap"
        data-code="{{item.code}}"
        data-index="{{index}}"
      >
        <view wx:if="{{editMode}}" class="check-box {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</view>
        <view class="fund-name">{{item.name}}</view>
        <view wx:if="{{!editMode}}" class="fund-pct {{item.cls}}">{{item.pctText}}</view>
        <view
          wx:if="{{editMode}}"
          class="drag-handle"
          catchtouchstart="onDragTouchStart"
          catchtouchmove="onDragTouchMove"
          catchtouchend="onDragTouchEnd"
          data-index="{{index}}"
          data-code="{{item.code}}"
        >≡</view>
      </view>
    </view>

    <view wx:if="{{editMode}}" class="edit-hint">勾选基金后可批量删除，拖拽 ≡ 手柄可排序</view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!funds.length && !showResults}}" class="empty">
    <view class="empty-art">
      <text class="art-line">帮助您记录</text>
      <text class="art-main">每一天</text>
      <text class="art-line">的收支明细</text>
    </view>
  </view>
</view>
