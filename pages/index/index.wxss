.page {
  padding: 20rpx 24rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.search-bar {
  position: relative;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 0 28rpx;
  height: 76rpx;
  box-shadow: 0 4rpx 16rpx rgba(47, 111, 237, 0.08);
}

.search-icon {
  font-size: 28rpx;
  color: #b0b6bd;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 76rpx;
  color: #1f2329;
}

.ph {
  color: #b0b6bd;
  font-size: 27rpx;
}

.clear-btn {
  color: #b0b6bd;
  font-size: 28rpx;
  padding-left: 16rpx;
  flex-shrink: 0;
}

.results {
  margin-top: 16rpx;
  overflow: hidden;
}

.result-tip {
  padding: 28rpx;
  text-align: center;
  color: #8a9099;
  font-size: 26rpx;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.result-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.result-name {
  font-size: 28rpx;
  color: #1f2329;
}

.result-sub {
  font-size: 22rpx;
  color: #8a9099;
  margin-top: 6rpx;
}

.result-add {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #2f6fed;
  padding: 8rpx 20rpx;
  border: 1rpx solid #d5e0fb;
  border-radius: 24rpx;
}

.result-add.added {
  color: #b0b6bd;
  border-color: #e5e7ea;
  background: #f5f6f8;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
}

.section-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.action-link {
  font-size: 24rpx;
  color: #2f6fed;
}

.action-link.delete {
  color: #b0b6bd;
}

.action-link.delete.active {
  color: #e0403f;
}

.gear {
  font-size: 32rpx;
  color: #8a9099;
  padding-left: 8rpx;
}

.check-box {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #cfd4da;
  border-radius: 50%;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  background: #fff;
}

.check-box.checked {
  background: #2f6fed;
  border-color: #2f6fed;
}

.fund.selected {
  background: #eef3ff !important;
}

.edit-hint {
  padding: 16rpx 8rpx;
  font-size: 22rpx;
  color: #8a9099;
  text-align: center;
}

/* 搜索历史（搜索时显示在搜索栏下方） */
.history {
  margin: 16rpx 0 0;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
}

.history-title {
  font-size: 24rpx;
  color: #8a9099;
}

.history-clear {
  font-size: 24rpx;
  color: #b0b6bd;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 8rpx;
}

.history-tag {
  font-size: 24rpx;
  color: #4b5563;
  background: #f5f6f8;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fund-list {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.fund {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f1f3;
  overflow: hidden;
}

.fund:last-child {
  border-bottom: none;
}

/* 涨跌背景色：渐变 */
.fund.up {
  background: linear-gradient(90deg, rgba(224, 64, 63, 0.12) 0%, #ffffff 100%);
}

.fund.down {
  background: linear-gradient(90deg, rgba(18, 160, 92, 0.12) 0%, #ffffff 100%);
}

.fund.flat {
  background: #ffffff;
}

.fund-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  line-height: 1.3;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 20rpx;
}

.fund-pct {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.1;
  flex-shrink: 0;
}

/* 拖拽手柄 */
.drag-handle {
  flex-shrink: 0;
  width: 60rpx;
  text-align: center;
  font-size: 36rpx;
  color: #cfd4da;
  margin-left: 12rpx;
}

/* 编辑模式下拖拽手柄加粗高亮 */
.fund .drag-handle:active {
  color: #2f6fed;
}

/* 拖拽中：当前项高亮 */
.fund.dragging {
  opacity: 0.5;
  background: #eef1f5 !important;
}

/* 落点指示 */
.fund.drag-over {
  border-top: 4rpx solid #2f6fed;
}

.empty {
  margin-top: 200rpx;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 112rpx;
  margin: 0 auto 24rpx;
  border: 2rpx dashed #cfd4da;
  border-radius: 50%;
  color: #cfd4da;
  font-size: 60rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #4b5563;
}

.empty-art {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-art .art-line {
  font-size: 32rpx;
  font-weight: 600;
  color: #2f3a4a;
  letter-spacing: 8rpx;
}

.empty-art .art-main {
  font-size: 96rpx;
  font-weight: 900;
  letter-spacing: 16rpx;
  line-height: 1.2;
  /* 渐变文字：兼容写法 */
  background: linear-gradient(90deg, #2f6fed 0%, #9b30ff 50%, #e0403f 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
  /* 轻微发光，增强醒目度 */
  filter: drop-shadow(0 4rpx 12rpx rgba(106, 79, 240, 0.35));
  position: relative;
  padding: 4rpx 32rpx;
}

.empty-art .art-main::before,
.empty-art .art-main::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 80rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, transparent, #6a4ff0, transparent);
}

.empty-art .art-main::before {
  right: 100%;
  margin-right: 12rpx;
}

.empty-art .art-main::after {
  left: 100%;
  margin-left: 12rpx;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a9099;
}
