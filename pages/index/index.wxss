.page {
  padding: 20rpx 24rpx 40rpx;
}

.search-bar {
  position: relative;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 72rpx;
}

.ph {
  color: #b0b6bd;
}

.clear-btn {
  color: #b0b6bd;
  font-size: 30rpx;
  padding-left: 16rpx;
}

.results {
  margin-top: 16rpx;
  overflow: hidden;
}

.result-tip {
  padding: 28rpx;
  text-align: center;
  color: #8a9099;
  font-size: 26rpx;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.result-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.result-name {
  font-size: 28rpx;
  color: #1f2329;
}

.result-sub {
  font-size: 22rpx;
  color: #8a9099;
  margin-top: 6rpx;
}

.result-add {
  font-size: 24rpx;
  color: #2f6fed;
  padding: 8rpx 20rpx;
  border: 1rpx solid #d5e0fb;
  border-radius: 24rpx;
}

.result-add.added {
  color: #b0b6bd;
  border-color: #e5e7ea;
  background: #f5f6f8;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
}

.fund {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
}

.fund-left {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.fund-name {
  font-size: 30rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fund-sub {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
}

.fund-code {
  font-size: 22rpx;
  color: #8a9099;
}

.tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #6b7280;
  background: #f1f3f5;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.fund-right {
  text-align: right;
  min-width: 190rpx;
}

.fund-pct {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.1;
}

.fund-nav {
  font-size: 22rpx;
  color: #8a9099;
  margin-top: 8rpx;
}

.foot-tip {
  text-align: center;
  font-size: 22rpx;
  color: #b0b6bd;
  padding-top: 20rpx;
}

.empty {
  margin-top: 200rpx;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 112rpx;
  margin: 0 auto 24rpx;
  border: 2rpx dashed #cfd4da;
  border-radius: 50%;
  color: #cfd4da;
  font-size: 60rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #4b5563;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a9099;
}
