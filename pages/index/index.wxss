.page {
  padding: 20rpx 24rpx calc(120rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

/* 底部常驻风险提示 */
.disclaimer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 22rpx;
  color: #8a9099;
  background: rgba(245, 246, 248, 0.96);
  border-top: 1rpx solid #eceef1;
}

.search-bar {
  position: relative;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 0 28rpx;
  height: 76rpx;
  box-shadow: 0 4rpx 16rpx rgba(47, 111, 237, 0.08);
}

.search-icon {
  font-size: 28rpx;
  color: #b0b6bd;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 76rpx;
  color: #1f2329;
}

.clear-btn {
  color: #b0b6bd;
  font-size: 28rpx;
  padding-left: 16rpx;
  flex-shrink: 0;
}

.results {
  margin-top: 16rpx;
  overflow: hidden;
}

.result-tip {
  padding: 28rpx;
  text-align: center;
  color: #8a9099;
  font-size: 26rpx;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.result-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.result-name {
  font-size: 28rpx;
  color: #1f2329;
}

.result-sub {
  font-size: 22rpx;
  color: #8a9099;
  margin-top: 6rpx;
}

.result-add {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #2f6fed;
  padding: 8rpx 20rpx;
  border: 1rpx solid #d5e0fb;
  border-radius: 24rpx;
}

.result-add.added {
  color: #b0b6bd;
  border-color: #e5e7ea;
  background: #f5f6f8;
}

.action-link {
  font-size: 24rpx;
  color: #2f6fed;
}

.action-link.delete {
  color: #b0b6bd;
}

.action-link.delete.active {
  color: #e0403f;
}

.gear {
  font-size: 36rpx;
  color: #8a9099;
  line-height: 1;
  padding: 4rpx 0 4rpx 8rpx;
}

.gear.exit {
  font-size: 26rpx;
  color: #2f6fed;
  padding: 8rpx 0;
}

.gear.blinking {
  animation: gear-blink 0.6s ease-in-out infinite;
  pointer-events: none;
}

@keyframes gear-blink {
  0%, 100% { opacity: 1; color: #2f6fed; }
  50% { opacity: 0.2; }
}

.check-box {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #cfd4da;
  border-radius: 50%;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  background: #fff;
}

.check-box.checked {
  background: #2f6fed;
  border-color: #2f6fed;
}

.fund.selected {
  background: #eef3ff !important;
}

.edit-hint {
  padding: 16rpx 8rpx;
  font-size: 22rpx;
  color: #8a9099;
  text-align: center;
}

/* 搜索历史（搜索时显示在搜索栏下方） */
.history {
  margin: 16rpx 0 0;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
}

.history-title {
  font-size: 24rpx;
  color: #8a9099;
}

.history-clear {
  font-size: 24rpx;
  color: #b0b6bd;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 8rpx;
}

.history-tag {
  font-size: 24rpx;
  color: #4b5563;
  background: #f5f6f8;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fund-list {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.tr.th {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #e3ecfb;
  border-bottom: 1rpx solid #d5e0fb;
}

.tr.th .name {
  flex: 1;
  font-size: 26rpx;
  color: #4a5a78;
  font-weight: 600;
}

.tr.th .num {
  font-size: 26rpx;
  color: #4a5a78;
  flex-shrink: 0;
  font-weight: 600;
  text-align: right;
  margin-left: 24rpx;
}

.tr.th .num .sub {
  font-size: 20rpx;
  color: #7d8ba6;
  font-weight: 400;
  vertical-align: sub;
  margin-left: 2rpx;
}

.fund {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f1f3;
  overflow: hidden;
  transition: transform 0.18s cubic-bezier(0.2, 0, 0, 1);
}

.fund:last-child {
  border-bottom: none;
}

/* 涨跌背景色：渐变 */
.fund.up {
  background: linear-gradient(90deg, rgba(224, 64, 63, 0.12) 0%, #ffffff 100%);
}

.fund.down {
  background: linear-gradient(90deg, rgba(18, 160, 92, 0.12) 0%, #ffffff 100%);
}

.fund.flat {
  background: #ffffff;
}

.fund-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  line-height: 1.3;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 20rpx;
}

.fund-pct {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.1;
  flex-shrink: 0;
  text-align: right;
  margin-left: 24rpx;
}

.drag-handle {
  flex-shrink: 0;
  width: 60rpx;
  text-align: center;
  font-size: 36rpx;
  color: #cfd4da;
  margin-left: 12rpx;
}

.fund .drag-handle:active {
  color: #2f6fed;
}

/* 拖拽中：当前项浮动跟随，取消 transition 保持跟手 */
.fund.dragging {
  opacity: 0.92;
  background: #ffffff !important;
  box-shadow: 0 12rpx 32rpx rgba(47, 111, 237, 0.22);
  z-index: 10;
  position: relative;
  transition: none;
}

.empty {
  margin-top: 200rpx;
  text-align: center;
}

.empty-art {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-art .art-line {
  font-size: 32rpx;
  font-weight: 600;
  color: #2f3a4a;
  letter-spacing: 8rpx;
}

.empty-art .art-main {
  font-size: 96rpx;
  font-weight: 900;
  letter-spacing: 16rpx;
  line-height: 1.2;
  background: linear-gradient(90deg, #2f6fed 0%, #9b30ff 50%, #e0403f 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 4rpx 12rpx rgba(106, 79, 240, 0.35));
  position: relative;
  padding: 4rpx 32rpx;
}

.empty-art .art-main::before,
.empty-art .art-main::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 80rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, transparent, #6a4ff0, transparent);
}

.empty-art .art-main::before {
  right: 100%;
  margin-right: 12rpx;
}

.empty-art .art-main::after {
  left: 100%;
  margin-left: 12rpx;
}

/* 资产卡 */
.asset {
  margin-top: 16rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.asset-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.asset-item.right {
  text-align: right;
  align-items: flex-end;
}

.asset-label {
  font-size: 24rpx;
  color: #8a9099;
}

.asset-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2329;
  letter-spacing: 1rpx;
}

.asset-value.up { color: #e0403f; }
.asset-value.down { color: #12a05c; }
.asset-value.flat { color: #8a9099; }

/* 标签栏 */
.tabs {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx 12rpx;
}

.tabs-left {
  display: flex;
  gap: 32rpx;
}

.tabs-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.tab {
  font-size: 30rpx;
  color: #8a9099;
  padding: 4rpx 0;
  position: relative;
}

.tab.on {
  color: #1f2329;
  font-weight: 700;
}

.tab.on::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -6rpx;
  height: 4rpx;
  background: #2f6fed;
  border-radius: 2rpx;
}

/* 设置菜单（锚定齿轮左下角） */
.gear-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.gear-menu {
  position: absolute;
  top: calc(100% + 12rpx);
  right: calc(100% - 16rpx);
  z-index: 101;
  padding: 8rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 35, 41, 0.18);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 28rpx;
}

.menu-item:active {
  background: #f5f6f8;
}

.menu-icon {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.menu-icon.cloud {
  background: #e8f0fe;
  color: #2f6fed;
}

.menu-icon.setting {
  background: #f0eafe;
  color: #6a4ff0;
}

/* CSS 画三横杠，避免 unicode 字符基线不居中 */
.menu-icon.setting .bars {
  width: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.menu-icon.setting .bar {
  height: 4rpx;
  border-radius: 2rpx;
  background: #6a4ff0;
}

.menu-title {
  font-size: 28rpx;
  color: #1f2329;
  white-space: nowrap;
}

.tr.th .num.profit-col {
  flex: 0 0 140rpx;
}

.fund .fund-pct.profit-col {
  flex: 0 0 140rpx;
}

.holdings-editor-row {
  flex-wrap: wrap;
}

.holdings-add-input {
  box-sizing: border-box;
  min-width: 0;
  height: 39rpx;
  font-size: 30rpx;
  font-weight: 400;
}

.holdings-add-default {
  color: #8a9099;
}

.holdings-editor-input {
  box-sizing: border-box;
  width: 140rpx;
  min-width: 0;
  height: 39rpx;
  padding: 0 4rpx;
  border-bottom: 1rpx solid #d5e0fb;
  border-radius: 0;
  color: #1f2329;
  background: transparent;
}

.holdings-editor-error {
  display: block;
  flex-basis: 100%;
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  color: #e0403f;
}

.holdings-editor-row .holdings-editor-error {
  padding: 8rpx 0;
}

/* 持有列表第三列固定宽，保证收益列右缘对齐 */
.tr.th .num.pct-col {
  flex: 0 0 140rpx;
}

.fund .fund-pct.pct-col {
  flex: 0 0 140rpx;
}


