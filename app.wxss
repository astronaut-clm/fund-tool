page {
  background-color: #f5f6f8;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #1f2329;
  font-size: 28rpx;
}

.up {
  color: #e0403f;
}

.down {
  color: #12a05c;
}

.flat {
  color: #8a9099;
}

.muted {
  color: #8a9099;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
}

.btn-primary {
  background: #2f6fed;
  color: #ffffff;
  border-radius: 12rpx;
  text-align: center;
}
